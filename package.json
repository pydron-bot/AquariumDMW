{
  "name": "tank",
  "version": "0.1.0",
  "private": true,
  "description": "three.js tech demo: a detailed recreation of Derek's planted 10-gallon tank.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets": "blender -b --factory-startup -P blender/build.py -- --out public/assets"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
